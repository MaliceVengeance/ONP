# Staging environment template — placeholder values only, safe to commit.
#
# To use: copy this file to .env.staging.local and fill in real staging
# credentials there. .env.staging.local is covered by the .env* rule in
# .gitignore, so it is never committed. This file (.env.staging.example)
# must never contain real secrets — it exists purely as a checked-in
# reference so anyone can see which variables staging needs without asking.
#
# Run against this config with:
#   npm run dev:staging
#
# Every value below must point at STAGING resources — a separate Supabase
# project and Stripe TEST-mode keys, never the production project or Stripe
# live-mode keys. Mirrors the variable set in .env.local exactly, plus
# DATABASE_URL for direct-Postgres tooling (see note below).

# --- Supabase (staging project — must NOT be the production project ref) ---
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<staging-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-key>

# Direct Postgres connection string, for scripts/tooling that talk to
# Postgres directly instead of through the Supabase client libraries (e.g.
# migration testing, schema introspection). Not read by the Next.js app
# itself. Find this under the staging project's Settings > Database >
# Connection string (use the direct connection, not the pgbouncer pooler,
# if the tooling needs to run statements like CREATE DATABASE).
DATABASE_URL=postgres://postgres:<password>@db.<staging-project-ref>.supabase.co:5432/postgres

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (TEST-mode keys only — never a live-mode key in this file) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<staging-publishable-key>
STRIPE_SECRET_KEY=sk_test_<staging-secret-key>
STRIPE_WEBHOOK_SECRET=whsec_<staging-webhook-secret>
STRIPE_STANDARD_PRICE_ID=price_<staging-standard-price-id>
STRIPE_VETERAN_PRICE_ID=price_<staging-veteran-price-id>
STRIPE_EMERGENCY_PRICE_ID=price_<staging-emergency-price-id>
STRIPE_STANDARD_3MO_PRICE_ID=price_<staging-standard-3mo-price-id>
STRIPE_STANDARD_6MO_PRICE_ID=price_<staging-standard-6mo-price-id>
STRIPE_STANDARD_12MO_PRICE_ID=price_<staging-standard-12mo-price-id>
STRIPE_VETERAN_3MO_PRICE_ID=price_<staging-veteran-3mo-price-id>
STRIPE_VETERAN_6MO_PRICE_ID=price_<staging-veteran-6mo-price-id>
STRIPE_VETERAN_12MO_PRICE_ID=price_<staging-veteran-12mo-price-id>

# --- Other services ---
RESEND_API_KEY=<staging-resend-api-key>
NEXT_PUBLIC_MAPBOX_TOKEN=<staging-or-shared-mapbox-token>
CRON_SECRET=<staging-cron-secret>
