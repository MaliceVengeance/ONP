{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      { "name": "next" }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "src/app/dashboard/client/projects/[id]/files/uploadPipeline.test.ts",
    "src/lib/isNextRedirectError.test.ts",
    "src/lib/isOpenEndedRfiPrompt.test.ts",
    "src/lib/postCloseReconfirmation.test.ts",
    "src/lib/withdrawalReasonRouting.test.ts",
    "src/lib/rfiAttachmentPreview.test.ts",
    "src/lib/attachmentHistoryDisplay.test.ts",
    "src/lib/sensitiveRemovalDecision.test.ts"
  ]
}