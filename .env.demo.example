# Demo environment template — placeholder values only, safe to commit.
#
# To use: copy this file to .env.demo.local and fill in real demo-project
# credentials there. .env.demo.local is covered by the .env* rule in
# .gitignore, so it is never committed.
#
# Run against this config with:
#   npm run dev:demo
#   npm run demo:seed
#   npm run demo:reset
#   npm run demo:reveal
#   npm run demo:award
#
# Every value below must point at a DEDICATED DEMO Supabase project — never
# the staging project (qbdihnmgxtowqnvzflfh) and never the production
# project (efxjujtetreipxvxxfip). scripts/demo/assertDemoEnvironment.ts
# refuses to run against either of those refs unconditionally, regardless
# of what this file says, but don't rely on that guard alone — this file
# should simply never point anywhere else in the first place.
#
# Before any demo:* script will run, scripts/demo/setup-demo-marker.sql
# must have already been run BY HAND, directly against this demo project —
# see that file for why.

# --- Supabase (dedicated demo project only) ---
NEXT_PUBLIC_SUPABASE_URL=https://<demo-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<demo-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<demo-service-role-key>

# Direct Postgres connection string, for the migration-replay step
# (016_complete_schema_baseline.sql through the latest numbered migration)
# and any other direct-Postgres tooling. Not read by the Next.js app
# itself.
DATABASE_URL=postgres://postgres:<password>@db.<demo-project-ref>.supabase.co:5432/postgres

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Demo-only safety guard (see scripts/demo/assertDemoEnvironment.ts) ---
# The project ref the demo scripts are explicitly expecting. Must match
# the ref embedded in NEXT_PUBLIC_SUPABASE_URL above.
DEMO_SUPABASE_PROJECT_REF=<demo-project-ref>
# Independent human confirmation, checked separately from the ref match.
# Must be exactly "true".
ALLOW_DEMO_SEED=true

# --- Demo account credentials ---
# Shared password used to create/reset every synthetic demo account
# (client + all contractors). Never checked into source — this is the
# only place it lives. Pick anything memorable for recording; it has no
# access to anything beyond this demo project's fictional accounts.
DEMO_ACCOUNT_PASSWORD=<demo-account-password>

# --- Demo-mode on-screen disclosure ---
# Renders a persistent "ONP Demonstration — Fictional project and
# contractor data" banner. Must never be set in .env.staging.local,
# .env.local, or any Vercel project environment.
NEXT_PUBLIC_DEMO_MODE=true

# Stripe and Resend are intentionally omitted here — the demo flow does
# not require either. Contractor bid-eligibility is satisfied by a
# directly-seeded ACTIVE contractor_subscriptions row (no Stripe
# involvement), and every email/notification code path in the app already
# tolerates a missing/invalid RESEND_API_KEY by design (best-effort send,
# logged to notification_outbox, never a crash).
